# This file extends the ignore list from needrestart.conf.
# It is managed by Ansible.

{% for key, services in needrestart_ignorelist.items()|sort %}
# {{ key }}
{% for service in services|sort %}
$nrconf{override_rc}->{q(^{{ service }})} = 0;
{% endfor %}

{% endfor %}

{% for key, containers in needrestart_ignorelist_cont.items()|sort %}
# {{ key }}
{% for container in containers|sort %}
$nrconf{override_cont}->{q(^{{ container }})} = 0;
{% endfor %}

{% endfor %}
